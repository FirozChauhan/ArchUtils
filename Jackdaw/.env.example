# Jackdaw configuration - copy to .env and edit. Real env vars override these.

# Root folder containing one subfolder per profile
WALLPAPERS_ROOT=

# Where per-profile state (profile -> last wallpaper filename) is kept
DB_PATH=./wallpaper.json

# Seconds between wallpaper changes
DELAY_SECONDS=3600

# Comma-separated extensions considered wallpapers (case-insensitive).
# Only formats hyprpaper's loader (hyprgraphics) can decode — it was built
# without HEIF, and gif/tiff/bmp fail too (black screen, silent "ok" IPC).
IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp,.jxl

# Seconds --restore waits for hyprpaper's IPC socket at boot before giving up
# (it runs right next to the autostart 'hyprpaper' line, so a wait is normal).
RESTORE_WAIT_SECONDS=20
