# Jackdaw configuration - copy to .env and edit. Real env vars override these.

# Root folder containing one subfolder per profile
WALLPAPERS_ROOT=

# Where per-profile state (profile -> last wallpaper filename) is kept
DB_PATH=./wallpaper.json

# Wallpaper setter binary (swww v3+ is 'awww'; older installs use 'swww')
SETTER=awww

# Seconds between wallpaper changes
DELAY_SECONDS=3600

# Comma-separated extensions considered wallpapers (case-insensitive)
IMAGE_EXTENSIONS=.avif,.png,.jpg,.jpeg,.webp,.gif,.bmp,.tiff,.tif,.jxl
